{
  "name": "identity-navigator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:pages",
    "build:pages": "next build && node scripts/prepare-pages-pwa.mjs",
    "test": "npm run verify:forms && npm run build:pages && node --test tests/rendered-html.test.mjs tests/wizard-routing.test.mjs",
    "verify:forms": "node --experimental-strip-types scripts/verify-form-registry.mjs",
    "qa:pdfs": "node --import tsx scripts/generate-qa-samples.ts",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Identity Court Navigator"
}
